        "\n",
        "def triage_request(request_text, threshold=0.70):\n",
        "    # Get the model's estimated category probabilities.\n",
        "    probabilities = model.predict_proba([request_text])[0]\n",
        "\n",
        "    # Identify the category with the highest score.\n",
        "    best_index = probabilities.argmax()\n",
        "\n",
        "    predicted_category = model.classes_[best_index]\n",
        "    model_score = float(probabilities[best_index])\n",
        "\n",
        "    # Flag uncertain predictions for human review.\n",
        "    if model_score < threshold:\n",
        "        decision = \"HUMAN REVIEW REQUIRED\"\n",
        "    else:\n",
        "        decision = \"PROVISIONAL ROUTING SUGGESTION\"\n",
        "\n",
        "    return {\n",
        "        \"request\": request_text,\n",
        "        \"predicted_category\": predicted_category,\n",
        "        \"model_score\": round(model_score, 3),\n",
        "        \"decision\": decision\n",
        "    }\n",
        "\n",
        "print(\"Human-review function created successfully!\")\n"
      ],
